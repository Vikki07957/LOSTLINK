# LOSTLINK - Environment Configuration
# Flask Settings
SECRET_KEY=lostlink-super-secret-mca-project-key-2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# MongoDB Atlas Connection
# To connect your MongoDB Atlas cluster:
# 1. Go to cloud.mongodb.com -> Database -> Connect -> Drivers
# 2. Copy the connection string and replace the placeholder below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lostlink_db?retryWrites=true&w=majority
DB_NAME=lostlink_db

# File Upload Settings
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
UPLOAD_FOLDER=static/uploads
